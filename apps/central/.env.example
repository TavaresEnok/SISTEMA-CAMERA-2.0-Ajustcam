DRAC_CENTRAL_HOST=0.0.0.0
DRAC_CENTRAL_PORT=9765
DRAC_CENTRAL_ADMIN_EMAIL=admin@drac.local
DRAC_CENTRAL_ADMIN_PASSWORD_HASH=change_me_pbkdf2_sha256_hash
DRAC_CENTRAL_SESSION_HOURS=8
DRAC_CENTRAL_ADMIN_TOKEN=
DRAC_CENTRAL_DATA_FILE=./data/installations.json
DRAC_CENTRAL_ALLOWED_ORIGINS=https://central.seudominio.com.br
DRAC_CENTRAL_TRUSTED_PROXIES=127.0.0.1/32,::1/128
DRAC_CENTRAL_COOKIE_SECURE=true
DRAC_CENTRAL_PUBLIC_URL=https://central.seudominio.com.br
DRAC_CENTRAL_LOGIN_MAX_ATTEMPTS=8
DRAC_CENTRAL_LOGIN_WINDOW_MINUTES=15
DRAC_CENTRAL_ONLINE_THRESHOLD_SECONDS=180
DRAC_CENTRAL_HISTORY_LIMIT=100
DRAC_CENTRAL_AUDIT_HISTORY_LIMIT=500
# Instalador aprovado: o commit e o SHA-256 são obrigatórios. O hash deve vir
# do pipeline/operador de release por um canal confiável, nunca ser baixado
# junto do artefato. Sem ambos a Central recusa gerar comandos.
DRAC_CENTRAL_INSTALLER_COMMIT=
DRAC_CENTRAL_INSTALLER_SHA256=
DRAC_CENTRAL_INSTALLER_URL_TEMPLATE=https://raw.githubusercontent.com/TavaresEnok/DRAC/{commit}/scripts/install-drac.sh
DRAC_CENTRAL_REPOSITORY_URL=https://github.com/TavaresEnok/DRAC.git
DRAC_CENTRAL_INSTALLER_TOKEN_TTL_SECONDS=900
DRAC_CENTRAL_INSTALLER_TOKEN_MAX_DOWNLOADS=3
# ── Datastore (item 2.10): JSON → Postgres com migração segura ────────────────
# SEM DRAC_CENTRAL_DATABASE_URL a Central usa o arquivo JSON (comportamento atual,
# DEFAULT). Definindo a URL, a Central passa a ler do Postgres. Na 1ª subida ela:
#   1) faz BACKUP das identidades de assinatura (licenseKey/digest do token/host keys
#      + hashes de admin) em DRAC_CENTRAL_BACKUP_DIR — ANTES de qualquer migração;
#   2) reconcilia (backfill) o JSON legado para o Postgres.
# Modo dual = lê do Postgres e cai para o JSON legado (read-only, janela de rollback);
# escreve SÓ no Postgres. Depois de validar, mude para pg (só Postgres).
# DRAC_CENTRAL_DATABASE_URL=postgres://usuario:senha@host:5432/central
# DRAC_CENTRAL_STORE_MODE=dual        # json | dual | pg (default: dual quando há URL)
# DRAC_CENTRAL_BACKUP_DIR=./data/backups
# Central e web devem compartilhar a rede Docker. Assim os downloads continuam
# funcionando mesmo com a porta 5173 presa ao loopback do host.
APP_BUILDER_AGENT_URL=http://172.17.0.1:8780
APK_SOURCE_BASE=http://web
